width: Fill height: Fill flow: Down spacing: 12
show_bg: true draw_bg.color: mod.widgets.RINX_PAGE

if !mod.rinx_theme.reloading() {
    mod.palpo = {ready: false busy: false admin: false approver: false reviewer: false user: "" page: "inbox" filter: "needs_action"
        rows: [] resources: [] selected: nil selected_fleet: nil watch_generation: 0 pending: 0 offset: 0 total: 0 notice: "Connecting with your Rinx account…"
        notification_settings: nil device_time_zone: nil quiet_enabled: false quiet_start: "22:00" quiet_end: "08:00" quiet_zone: "UTC"
        form: {title: "" service: "" payload: {} fields: []} has_draft: false request_count: 0}
    if fs.exists("draft.json") {
        let saved = fs.read("draft.json").parse_json()
        if saved != nil {
            if saved.service == "palpo.fleets.register" || (saved.service == "palpo.inbox.submit" && saved.payload.kind == "contribution") { fs.write("draft.json", "null") }
            else { mod.palpo.form = saved mod.palpo.has_draft = true }
        }
    }
}
let P = mod.palpo
// Dynamic render closures resolve the current host prototypes on every reapply.
mod.widgets.PalpoCard = RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 10
    draw_bg +: {color: mod.widgets.RINX_SURFACE border_color: mod.widgets.RINX_BORDER border_size: 1 border_radius: theme.corner_radius}}

fn draw_page(){ ui.content.render() ui.navigation.render() ui.status.set_text(P.notice) }
fn connection_verified(fleet){
    return fleet != nil && fleet.state == "ready" && fleet.readiness != nil && fleet.readiness.eventDelivery == "verified" && fleet.readiness.verifiedAt != nil
}
fn connection_label(fleet){
    if connection_verified(fleet) {
        if fleet.transport != nil && fleet.transport.mode == "outbound" && !fleet.transport.online { return "Connection verified · Hagency offline" }
        return "Connection verified"
    }
    if fleet != nil && fleet.state == "pending_connection" { return "Connection not yet verified" }
    if fleet != nil { return fleet.state }
    return "Checking connection status…"
}
fn action_label(row){
    if row.kind == "agent_removal" {
        if row.execution == "awaiting_hagency" { return "Removal requested · waiting for Hagency" }
        if row.execution == "command_refused" { return "Removal was refused · review the result" }
        if row.execution == "cleanup_failed" { return "Cleanup failed · retry is available" }
        if row.execution == "inspection_required" { return "Cleanup is uncertain · runtime inspection is required" }
        if row.execution == "done" { return "Agent removed · cleanup verified" }
        if row.execution == "superseded" { return "A newer removal attempt is available" }
        return "Removing agent · waiting for runtime and Matrix cleanup"
    }
    if row.kind == "top_up" {
        if row.execution == "awaiting_hagency" { return "Token increase approved · waiting for Hagency" }
        if row.execution == "command_refused" { return "Token increase could not be applied · review the result" }
        if row.execution == "done" { return if row.state == "approved" {"Token increase applied to the same agent"} else {"Token increase rejected"} }
        return "Token increase · waiting for the assigned project administrator"
    }
    if row.kind == "agent" {
        if row.execution == "awaiting_hagency" { return "Decision recorded · waiting for Hagency" }
        if row.execution == "command_refused" { return "Hagency could not apply the decision · review the result" }
        if row.execution == "done" { return if row.state == "approved" {"Approval applied · check agent readiness"} else {"Agent request rejected"} }
        return "Waiting for the assigned project administrator"
    }
    if row.kind == "project" {
        if row.workflowVersion == 1 {
            if row.execution == "preparing" { return "Finish preparing the project room" }
            if row.execution == "awaiting_reservation" { return "Approved · waiting for Hagency to reserve the budget" }
            if row.execution == "reservation_refused" { return "Budget reservation refused · review the result" }
            if row.execution == "releasing_reservations" { return "Releasing unused reservations · waiting for Hagency" }
            if row.execution == "release_refused" { return "Unused release refused · reservations remain held" }
            if row.execution == "released" { return "Failed allocation closed · unused reservations released" }
            if row.execution == "done" { return "Project allocated · ready for agent requests" }
        }
        if row.state == "requested" { return "Waiting for project approval" }
        if row.state == "approved" {
            if row.execution == "done" { return "Project created · request an agent from Projects" }
            return "Project approved · ready to create"
        }
    }
    return row.kind + " · " + row.state
}
fn reservation_result(code){
    if code == "insufficient_capacity" { return "The contribution cannot currently cover this budget." }
    if code == "authority" { return "Administrator permission changed. Review access before retrying." }
    if code == "expired" || code == "grant_expired" { return "The approved reservation expired." }
    if code == "grant_revoked" { return "The contribution or project was revoked." }
    if code == "conflict" { return "The reviewed allocation changed or has already funded an agent." }
    if code == "resource_unavailable" { return "The selected resource is unavailable." }
    if code == "not_found" { return "Hagency could not find the reviewed allocation." }
    return "Hagency could not apply this operation. Review the latest allocation before retrying."
}
fn stop_connection_watch(){ P.watch_generation = P.watch_generation + 1 }
fn read_connection(id, generation, remaining){
    if generation != P.watch_generation || !P.ready { return }
    if P.busy { start_timeout(2.0, || read_connection(id, generation, remaining)) return }
    host.request("palpo.fleets.list", {}, fn(r){
        if generation != P.watch_generation || !P.ready { return }
        if !r.is_ok { P.notice = r.error stop_connection_watch() draw_page() return }
        let found = nil
        for i in r.data.fleets.len() { if r.data.fleets[i].id == id { found = r.data.fleets[i] } }
        P.selected_fleet = found
        if P.page == "fleets" { P.rows = r.data.fleets }
        if connection_verified(found) { P.notice = "Connection verified" stop_connection_watch() }
        else if found == nil { P.notice = "This fleet is no longer available to your account." stop_connection_watch() }
        else if remaining > 1 { start_timeout(2.0, || read_connection(id, generation, remaining - 1)) }
        else { P.notice = "Verification is still pending. Refresh to check again." stop_connection_watch() }
        draw_page()
    })
}
fn watch_connection(id){
    stop_connection_watch()
    let generation = P.watch_generation
    start_timeout(2.0, || read_connection(id, generation, 30))
}
fn call(service, args, complete){
    if P.busy { return }
    P.busy = true
    P.request_count = P.request_count + 1
    P.notice = "Working…"
    ui.status.set_text(P.notice)
    host.request(service, args, fn(r){
        P.busy = false
        if r.is_ok { P.notice = "" complete(r.data) }
        else { P.notice = r.error }
        draw_page()
    })
}
fn connect_app(){
    call("palpo.session.open", {}, fn(data){
        P.ready = true P.admin = data.isAdmin P.approver = data.canApproveProjects P.reviewer = data.canReviewAgents P.user = data.userId
        if data.openAction != "" { review_action({id: data.openAction}) } else { refresh_page() }
    })
}
fn open_page(page){
    if P.busy { return }
    stop_connection_watch()
    P.page = page P.rows = [] P.selected = nil P.selected_fleet = nil P.notice = "" P.offset = 0
    draw_page() refresh_page()
}
fn inbox_filter(value){ P.filter = value open_page("inbox") }
fn inbox_page(offset){ if P.busy { return } P.offset = offset P.rows = [] refresh_page() }
fn refresh_page(){
    if !P.ready { connect_app() return }
    if P.page == "action" { review_action(P.selected) return }
    if P.page == "inbox" {
        call("palpo.inbox.list", {view: P.filter offset: P.offset limit: 50}, fn(data){ P.rows = data.actions P.pending = data.pendingCount P.total = data.total })
    }
    if P.page == "notifications" {
        call("palpo.notifications.get", {}, fn(data){ apply_notification_settings(data) })
    }
    if P.page == "projects" {
        call("palpo.projects.list", {}, fn(data){ P.rows = data.projects })
    }
    if P.page == "requests" {
        call("palpo.requests.list", {}, fn(data){ P.rows = data.requests })
    }
    if P.page == "resources" {
        call("palpo.catalog.list", {}, fn(data){ P.rows = data.fleets })
    }
    if P.page == "fleets" {
        call("palpo.fleets.list", {}, fn(data){ P.rows = data.fleets })
    }
    if P.page == "activity" {
        call("palpo.activity.list", {}, fn(data){ P.rows = data.events })
    }
    if P.page == "accounts" {
        call("palpo.accounts.list", {}, fn(data){ P.rows = data.requests })
    }
    if P.page == "agents" {
        call("palpo.agents.list", {fleetId: P.selected.id}, fn(data){ P.rows = data.agents })
    }
}
fn apply_notification_settings(data){
    P.notification_settings = data
    P.device_time_zone = data.deviceTimeZone
    P.quiet_enabled = data.quietHours != nil
    if P.quiet_enabled {
        P.quiet_start = data.quietHours.start P.quiet_end = data.quietHours.end P.quiet_zone = data.quietHours.timeZone
    } else {
        P.quiet_start = "22:00" P.quiet_end = "08:00"
        P.quiet_zone = if P.device_time_zone != nil {P.device_time_zone} else {"UTC"}
    }
}
fn save_notification_settings(){
    let prefs = P.notification_settings
    let quiet = nil
    if P.quiet_enabled { quiet = {start: P.quiet_start end: P.quiet_end timeZone: P.quiet_zone} }
    call("palpo.notifications.set", {expectedRevision: prefs.revision enabled: prefs.enabled remindersEnabled: prefs.remindersEnabled
        reminderMinutes: prefs.reminderMinutes quietHours: quiet}, fn(data){
        apply_notification_settings(data) P.notice = "Notification settings saved for your account. Pending actions stay in your Inbox."
    })
}
fn save_form(){ fs.write("draft.json", P.form.to_json()) P.has_draft = true }
fn has_form_field(key){
    for i in P.form.fields.len() { if P.form.fields[i].key == key { return true } }
    return false
}
fn edit_field(i, value){
    let key = P.form.fields[i].key
    P.form.fields[i].value = value
    if P.form.service == "palpo.inbox.submit" && (key == "tokens" || key == "maxAgents" || key == "maxRatePerDay") {
        P.form.payload.allocations[0].limits[key] = value
    } else if P.form.service == "palpo.inbox.submit" && key == "durationHours" {
        P.form.payload.allocations[0].durationHours = value
    } else { P.form.payload[key] = value }
    save_form()
}
fn new_form(title, service, payload, fields){
    if P.busy { return }
    stop_connection_watch()
    call("palpo.intent.new", {}, fn(data){
        if service == "palpo.inbox.decide" || service == "palpo.inbox.recover" { payload.commandId = data.requestId }
        if service == "palpo.inbox.submit" || service == "palpo.fleets.register" || service == "palpo.requests.create" || service == "palpo.fleets.migrate" { payload.requestId = data.requestId }
        P.form = {title: title service: service payload: payload fields: fields}
        P.page = "form" save_form()
    })
}
fn submit_form(){
    call(P.form.service, P.form.payload, fn(data){
        fs.write("draft.json", "null") P.has_draft = false
        P.notice = "Saved. The server will keep this request when you close the app."
        P.page = "inbox" P.filter = "waiting" P.selected = nil P.rows = [] P.offset = 0
        if P.form.service == "palpo.inbox.decide" { P.filter = "needs_action" }
        if P.form.service == "palpo.requests.create" { P.page = "requests" }
        if P.form.service == "palpo.fleets.register" || P.form.service == "palpo.fleets.migrate" || P.form.service == "palpo.agents.rename" || P.form.service == "palpo.agents.register" { P.page = "fleets" }
        refresh_page()
    })
}
fn request_project(fleet, resource, contribution){
    new_form("Request a project", "palpo.inbox.submit", {kind: "project" fleetId: fleet.id resourceIds: [resource.id] name: "" reason: ""
        allocations: [{contributionId: contribution.id resourceId: resource.id limits: {tokens: "" maxAgents: "" maxRatePerDay: ""} durationHours: ""}]}, [
        {key: "name" label: "Project name" value: ""}
        {key: "reason" label: "What will your project do?" value: ""}
        {key: "tokens" label: "Project token budget" value: ""}
        {key: "maxAgents" label: "Maximum concurrent agents" value: ""}
        {key: "maxRatePerDay" label: "Combined tokens per day" value: ""}
        {key: "durationHours" label: "Allocation duration (hours)" value: ""}
    ])
}
fn recover_project(operation){
    let row = P.selected
    new_form(if operation == "retry" {"Retry the approved project budget"} else {"Release the failed allocation"}, "palpo.inbox.recover",
        {id: row.id expectedRevision: row.revision operation: operation reason: ""},
        [{key: "reason" label: "Recovery reason" value: ""}])
}
fn review_action(row){
    call("palpo.inbox.get", {id: row.id}, fn(data){
        stop_connection_watch()
        P.selected = data.action P.selected_fleet = nil P.page = "action"
        host.request("palpo.inbox.seen", {id: row.id}, fn(r){})
        if data.action.kind == "contribution" && data.action.state == "approved" && data.action.execution == "done" {
            let fleet_id = data.action.result.fleetId
            call("palpo.fleets.list", {}, fn(result){
                for i in result.fleets.len() { if result.fleets[i].id == fleet_id { P.selected_fleet = result.fleets[i] } }
                if P.selected_fleet != nil && P.selected_fleet.state == "pending_connection" { watch_connection(fleet_id) }
            })
        }
    })
}
fn decision(value){
    let row = P.selected
    if value == "approve" && (row.kind == "agent" || row.kind == "top_up") {
        new_form(if row.kind == "top_up" {"Approve token increase"} else {"Approve agent allocation"}, "palpo.inbox.decide",
            {id: row.id expectedRevision: row.revision decision: value reason: "" allocatedTokens: row.payload.requestedTokens}, [
                {key: "allocatedTokens" label: if row.kind == "top_up" {"Approved additional tokens"} else {"Approved tokens"} value: "" + row.payload.requestedTokens}
                {key: "reason" label: "Decision reason" value: ""}
            ])
        return
    }
    if value == "approve" && row.kind == "project" && row.workflowVersion == 1 {
        new_form("Approve project budget", "palpo.inbox.decide",
            {id: row.id expectedRevision: row.revision decision: value reason: "" administrators: "" allowSelfApproval: false}, [
                {key: "administrators" label: "Project administrators (Matrix IDs, comma separated)" value: ""}
                {key: "reason" label: "Decision reason" value: ""}
            ])
        return
    }
    new_form(if value == "approve" {"Approve request"} else {"Reject request"}, "palpo.inbox.decide",
        {id: row.id expectedRevision: row.revision decision: value reason: ""}, [{key: "reason" label: "Decision reason" value: ""}])
}
fn request_top_up(row){
    new_form("Request more tokens", "palpo.inbox.submit",
        {kind: "top_up" agentRequestId: row.id addTokens: "" reason: ""}, [
            {key: "addTokens" label: "Additional tokens" value: ""}
            {key: "reason" label: "Why do you need more tokens?" value: ""}
        ])
}
fn remove_agent(id){
    new_form("Remove agent", "palpo.inbox.submit", {kind: "agent_removal" agentRequestId: id reason: ""}, [
        {key: "reason" label: "Reason for removal" value: ""}
    ])
}
fn continue_action(){
    call("palpo.inbox.activate", {id: P.selected.id}, fn(data){ P.selected = data.action P.notice = "Latest result received." })
}
fn snooze_action(){
    call("palpo.inbox.snooze", {id: P.selected.id minutes: 60}, fn(data){ P.selected = data.action P.notice = "Reminders snoozed for one hour. This action remains pending." })
}
fn fleet_action(fleet, operation){
    if operation == "export" {
        call("palpo.fleets.export", {fleetId: fleet.id}, fn(data){
            P.notice = if data.saved {"Configuration saved. Import it on your Hagency server, then verify the connection."} else {"Save cancelled. You can download the same configuration again."}
        })
    }
    if operation == "connect" {
        if P.busy { return }
        stop_connection_watch()
        call("palpo.fleets.connect", {fleetId: fleet.id}, fn(data){
            P.selected_fleet = data
            if P.page == "fleets" { for i in P.rows.len() { if P.rows[i].id == fleet.id { P.rows[i] = data } } }
            if connection_verified(data) { P.notice = "Connection verified" }
            else { P.notice = "Waiting for Hagency to verify the connection…" watch_connection(fleet.id) }
        })
    }
    if operation == "install" { call("palpo.fleets.install", {fleetId: fleet.id}, fn(data){ refresh_page() }) }
    if operation == "pause" || operation == "resume" || operation == "revoke" {
        P.selected = fleet P.form = {title: operation service: "palpo.fleets.set_state" payload: {fleetId: fleet.id action: operation} fields: []} P.page = "confirm" draw_page()
    }
    if operation == "queue" { call("palpo.fleets.queue", {fleetId: fleet.id}, fn(data){ P.notice = "Delivery queue: " + data.queue.pending + " pending / " + data.queue.records + " records." }) }
    if operation == "migrate" { new_form("Use outbound delivery", "palpo.fleets.migrate", {fleetId: fleet.id rotate: false}, []) }
}
fn open_agents(fleet){ stop_connection_watch() P.selected = fleet P.page = "agents" P.rows = [] draw_page() refresh_page() }
fn register_identity(){
    new_form("Register approved identity", "palpo.agents.register", {fleetId: P.selected.id agentId: "" role: "" displayName: "" approvedRequestId: ""}, [
        {key: "agentId" label: "Agent identifier" value: ""}
        {key: "displayName" label: "Display name" value: ""}
        {key: "role" label: "Public role" value: ""}
        {key: "approvedRequestId" label: "Approved request reference" value: ""}
    ])
}
fn rename_identity(agent){
    new_form("Rename identity", "palpo.agents.rename", {fleetId: P.selected.id agentId: agent.id displayName: agent.displayName}, [
        {key: "displayName" label: "Display name" value: agent.displayName}
    ])
}
fn retire_identity(agent){
    P.form = {title: "Retire Matrix identity" service: "palpo.agents.retire" payload: {fleetId: P.selected.id agentId: agent.id} fields: []}
    P.page = "confirm" draw_page()
}
fn select_agent_resource(project){
    stop_connection_watch()
    P.selected = project P.page = "agent_resources" P.rows = []
    call("palpo.catalog.list", {projectId: project.id}, fn(data){ P.rows = data.fleets })
}
fn request_agent(resource, role){
    new_form("Request an agent", "palpo.requests.create", {projectId: P.selected.id role: role requestedTokens: "100000" ratePerDay: "10000" agentDefinition: {name: "" resourceId: resource.id}}, [
        {key: "agentName" label: "Agent name" value: ""}
        {key: "requestedTokens" label: "Initial tokens" value: "100000"}
        {key: "ratePerDay" label: "Daily rate" value: "10000"}
    ])
}
fn submit_current(){
    if P.form.service == "palpo.requests.create" {
        P.form.payload.agentDefinition.name = P.form.fields[0].value
        // agentName is a form-only key, not a second backend identity field.
        let old = P.form.payload
        P.form.payload = {requestId: old.requestId projectId: old.projectId role: old.role requestedTokens: old.requestedTokens ratePerDay: old.ratePerDay agentDefinition: old.agentDefinition}
        save_form()
    }
    submit_form()
}

if !mod.rinx_theme.reloading() { start_timeout(0.05, || connect_app()) }
if mod.rinx_theme.reloading() { start_timeout(0.05, || {ui.content.render_style() ui.navigation.render_style()}) }

View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
    mod.widgets.RinxPageTitle{width: Fill text: "Palpo"}
    refresh := mod.widgets.RinxButton{text: "Refresh" on_click: || refresh_page()}
    disconnect := mod.widgets.RinxButton{text: "Disconnect" on_click: || call("palpo.session.disconnect", {}, fn(data){ stop_connection_watch() P.ready = false P.notice = "Palpo disconnected. Rinx remains signed in." })}
}
navigation := View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6 on_render: || {
    if P.ready {
        inbox := mod.widgets.RinxButton{text: if P.approver {"Project approvals · " + P.pending} else {"My Inbox · " + P.pending} on_click: || open_page("inbox")}
        projects := mod.widgets.RinxButton{text: "My projects" on_click: || open_page("projects")}
        requests := mod.widgets.RinxButton{text: "My agents" on_click: || open_page("requests")}
        resources := mod.widgets.RinxButton{text: if P.approver {"Published resources"} else {"Request a project"} on_click: || open_page("resources")}
        if P.admin {
            fleets := mod.widgets.RinxButton{text: "Connected Hagency" on_click: || open_page("fleets")}
            activity := mod.widgets.RinxButton{text: "Activity" on_click: || open_page("activity")}
            accounts := mod.widgets.RinxButton{text: "Signups" on_click: || open_page("accounts")}
        }
    }
}}
status := mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: P.notice}
content := ScrollYView{width: Fill height: Fill flow: Down spacing: 12 on_render: || {
    if !P.ready {
        mod.widgets.PalpoCard{
            mod.widgets.RinxPageTitle{width: Fill text: "Your account, one place"}
            mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: "Projects, resources and pending actions use the Matrix account you already signed into in Rinx."}
            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Your server must support Palpo mini apps. No additional password is needed."}
            retry := mod.widgets.RinxPrimaryButton{text: "Connect" on_click: || connect_app()}
        }
    }
    if P.ready {
        mod.widgets.RinxLabel{width: Fill text: if P.approver {"Palpo administrator"} else if P.reviewer {"Project administrator"} else {"Project manager"}}
        mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: P.user}
        if P.page == "inbox" {
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                needs := mod.widgets.RinxButton{text: "Needs my action" on_click: || inbox_filter("needs_action")}
                waiting := mod.widgets.RinxButton{text: "Waiting" on_click: || inbox_filter("waiting")}
                history := mod.widgets.RinxButton{text: "History" on_click: || inbox_filter("history")}
            }
            mod.widgets.PalpoCard{
                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Requests stay here until completed. Reading a notification does not complete an action."}
                notifications := mod.widgets.RinxButton{text: "Notification settings" on_click: || open_page("notifications")}
                if P.has_draft { resume := mod.widgets.RinxButton{text: "Resume draft" on_click: || {P.page = "form" draw_page()}} }
            }
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No requests in this view. Refresh to check for updates."} }
            for i in P.rows.len() {
                let row = P.rows[i]
                mod.widgets.PalpoCard{
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: row.payload.name}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: action_label(row)}
                    if row.reminderStatus != nil && row.reminderStatus.overdue {
                        mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Overdue · this action still needs your attention."}
                    }
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: row.payload.reason}
                    review := mod.widgets.RinxButton{text: "Open latest result" on_click: || review_action(row)}
                }
            }
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                if P.offset > 0 { previous := mod.widgets.RinxButton{text: "Previous" on_click: || inbox_page(P.offset - 50)} }
                if P.offset + 50 < P.total { next := mod.widgets.RinxButton{text: "Next" on_click: || inbox_page(P.offset + 50)} }
            }
        }
        if P.page == "action" {
            let row = P.selected
            mod.widgets.PalpoCard{
                mod.widgets.RinxPageTitle{width: Fill text: row.payload.name}
                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: action_label(row)}
                mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: row.payload.reason}
                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Requested by " + row.requesterMxid}
                if row.reminderStatus != nil {
                    if row.reminderStatus.overdue { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Overdue · the reminder schedule has elapsed. This action is still pending."} }
                    if !row.reminderStatus.enabled { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Reminders are off. This action stays in your Inbox."} }
                    if row.reminderStatus.snoozedUntil != nil { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Reminders snoozed until " + row.reminderStatus.snoozedUntil} }
                }
                if row.kind == "agent" || row.kind == "top_up" {
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: "Project: " + row.payload.projectName}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Requested: " + row.payload.requestedTokens + " tokens · " + row.payload.ratePerDay + " tokens/day"}
                    if row.execution == "command_refused" { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Result: " + row.result.code} }
                }
                if row.payload.allocations != nil {
                    for i in row.payload.allocations.len() {
                        let allocation = row.payload.allocations[i]
                        mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: allocation.resourceName}
                        mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: "Requested budget: " + allocation.limits.tokens + " tokens"}
                        mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Up to " + allocation.limits.maxAgents + " agents · " + allocation.limits.maxRatePerDay + " tokens/day · expires " + allocation.expiresAt}
                    }
                }
                if row.reservations != nil {
                    for i in row.reservations.len() {
                        let reservation = row.reservations[i]
                        if reservation.code != nil { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: reservation.resourceName + ": " + reservation_result(reservation.code)} }
                    }
                }
                if row.releases != nil {
                    for i in row.releases.len() {
                        let release = row.releases[i]
                        if release.code != nil { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: release.resourceName + ": " + reservation_result(release.code)} }
                    }
                }
                if row.canRetryReservation {
                    retry_reservation := mod.widgets.RinxPrimaryButton{text: "Retry refused reservations" on_click: || recover_project("retry")}
                }
                if row.canReleaseReservation {
                    release_reservation := mod.widgets.RinxButton{text: "Release failed allocation" on_click: || recover_project("release")}
                }
                if row.kind == "project" && row.execution == "released" && row.ownerMxid == P.user {
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Your project room and history are preserved. Select current resources to submit a new project request."}
                    new_project := mod.widgets.RinxPrimaryButton{text: "Request a new project" on_click: || open_page("resources")}
                }
                if row.canDecide {
                    View{width: Fill height: Fit spacing: 8
                        if row.workflowVersion == 1 { approve := mod.widgets.RinxPrimaryButton{text: "Approve" on_click: || decision("approve")} }
                        reject := mod.widgets.RinxButton{text: "Reject" on_click: || decision("reject")}
                    }
                }
                if row.canContinue && row.nextAction != "export_and_connect" {
                    continue_work := mod.widgets.RinxPrimaryButton{text: if row.nextAction == "prepare_project" {"Retry project preparation"} else {"Continue approved work"} on_click: || continue_action()}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Preparing a room does not allocate resources. Agents remain disabled until the reservation is confirmed."}
                }
                if row.kind == "contribution" && row.state == "approved" && row.execution == "done" {
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: connection_label(P.selected_fleet)}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Resource contribution is managed in Hagency. This is a record of the earlier setup."}
                }
                if row.kind == "project" && row.state == "approved" && row.execution == "done" {
                    projects := mod.widgets.RinxPrimaryButton{text: "Open Projects" on_click: || open_page("projects")}
                }
                if row.kind == "agent_removal" && row.canRetry {
                    retry_remove := mod.widgets.RinxPrimaryButton{text: "Retry cleanup" on_click: || remove_agent(row.payload.agentRequestId)}
                }
                if row.kind == "agent_removal" && row.execution == "command_refused" {
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Result: " + row.result.code}
                }
                if row.kind == "agent_removal" && row.execution == "inspection_required" {
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Ask the Hagency operator to inspect the interrupted cleanup. Retry is unavailable while the outcome is uncertain."}
                }
                if (row.kind == "agent" || row.kind == "top_up" || row.kind == "agent_removal") && row.ownerMxid == P.user {
                    agent_status := mod.widgets.RinxButton{text: "Open My agents" on_click: || open_page("requests")}
                }
                if row.needsMyAction { snooze := mod.widgets.RinxButton{text: "Remind me in an hour" on_click: || snooze_action()} }
                latest := mod.widgets.RinxButton{text: "Refresh result" on_click: || review_action(row)}
            }
        }
        if P.page == "notifications" && P.notification_settings != nil {
            let prefs = P.notification_settings
            mod.widgets.PalpoCard{
                mod.widgets.RinxPageTitle{width: Fill text: "Notifications"}
                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Saved for this Matrix account across devices. Pending actions stay in your Inbox even when notifications are off."}
                notifications_enabled := mod.widgets.RinxButton{text: if prefs.enabled {"Action notifications: On"} else {"Action notifications: Off"}
                    on_click: || {prefs.enabled = !prefs.enabled draw_page()}}
                reminders_enabled := mod.widgets.RinxButton{text: if prefs.remindersEnabled {"Reminders: On"} else {"Reminders: Off"}
                    on_click: || {prefs.remindersEnabled = !prefs.remindersEnabled draw_page()}}
                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Reminders are timed from when an action starts. Reading it does not finish it. Missed reminders are combined into one."}
                for i in prefs.reminderMinutes.len() {
                    let label = "Reminder " + (i + 1) + " (minutes after action starts)"
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: label}
                    mod.widgets.RinxInput{width: Fill text: "" + prefs.reminderMinutes[i] empty_text: label
                        on_change: |value| { prefs.reminderMinutes[i] = value }}
                }
                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Use increasing times between 15 minutes and 7 days. After the last reminder, the action remains pending."}
                quiet_hours := mod.widgets.RinxButton{text: if P.quiet_enabled {"Quiet hours: On"} else {"Quiet hours: Off"}
                    on_click: || {P.quiet_enabled = !P.quiet_enabled draw_page()}}
                if P.quiet_enabled {
                    mod.widgets.RinxLabel{width: Fill text: "Quiet hours start (HH:MM)"}
                    mod.widgets.RinxInput{width: Fill text: P.quiet_start empty_text: "Quiet hours start (HH:MM)" on_change: |value| {P.quiet_start = value}}
                    mod.widgets.RinxLabel{width: Fill text: "Quiet hours end (HH:MM)"}
                    mod.widgets.RinxInput{width: Fill text: P.quiet_end empty_text: "Quiet hours end (HH:MM)" on_change: |value| {P.quiet_end = value}}
                    mod.widgets.RinxLabel{width: Fill text: "Time zone"}
                    mod.widgets.RinxInput{width: Fill text: P.quiet_zone empty_text: "Time zone" on_change: |value| {P.quiet_zone = value}}
                    if P.device_time_zone != nil {
                        device_zone := mod.widgets.RinxButton{text: "Use this device's time zone" on_click: || {P.quiet_zone = P.device_time_zone draw_page()}}
                    }
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Use a time zone such as America/Los_Angeles. Quiet hours follow daylight saving time and postpone all Palpo notifications."}
                }
                save_notifications := mod.widgets.RinxPrimaryButton{text: "Save notification settings" on_click: || save_notification_settings()}
            }
        }
        if P.page == "form" {
            mod.widgets.PalpoCard{
                mod.widgets.RinxPageTitle{width: Fill text: P.form.title}
                if P.form.service == "palpo.inbox.recover" {
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: if P.form.payload.operation == "retry" {"Retry only the refused reservations using the same approved budget and administrators."} else {"Close this failed allocation after Hagency confirms the accepted reservations never funded an agent. Capacity stays held until that proof arrives."}}
                }
                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Draft saved on this device. You can retry safely."}
                if P.form.service == "palpo.inbox.submit" && P.form.payload.kind == "project" {
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Submission prepares your private project room for review. Agents can be requested only after the administrator approves and Hagency reserves the budget."}
                }
                if P.form.service == "palpo.inbox.submit" && P.form.payload.kind == "agent_removal" {
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Remove this agent and revoke its Matrix access. Chat history stays available. Removal is complete only when runtime and Matrix cleanup are verified."}
                }
                for i in P.form.fields.len() {
                    let item = P.form.fields[i]
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: item.label}
                    mod.widgets.RinxInput{width: Fill text: item.value empty_text: item.label on_change: |value| edit_field(i, value)}
                }
                if P.form.service == "palpo.inbox.decide" && P.form.payload.decision == "approve" && has_form_field("administrators") {
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Assigned administrators decide agent requests and token increases within this budget."}
                    self_approval := mod.widgets.RinxButton{text: if P.form.payload.allowSelfApproval {"Self-approval: allowed"} else {"Self-approval: forbidden"}
                        on_click: || { P.form.payload.allowSelfApproval = !P.form.payload.allowSelfApproval save_form() draw_page() }}
                }
                submit := mod.widgets.RinxPrimaryButton{text: "Submit" on_click: || submit_current()}
                cancel := mod.widgets.RinxButton{text: "Back to Inbox" on_click: || open_page("inbox")}
            }
        }
        if P.page == "confirm" {
            mod.widgets.PalpoCard{
                mod.widgets.RinxPageTitle{width: Fill text: P.form.title}
                mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: "This changes Matrix access. It does not confirm that a remote agent process has stopped."}
                confirm := mod.widgets.RinxPrimaryButton{text: "Confirm" on_click: || call(P.form.service, P.form.payload, fn(data){ open_page("fleets") })}
                cancel := mod.widgets.RinxButton{text: "Cancel" on_click: || open_page("fleets")}
            }
        }
        if P.page == "projects" {
            new_project := mod.widgets.RinxPrimaryButton{text: "Request a project" on_click: || open_page("resources")}
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No projects yet. Choose an offered resource to request one."} }
            for i in P.rows.len() {
                let project = P.rows[i]
                mod.widgets.PalpoCard{
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: project.name}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: project.state + " · " + project.ownerMxid}
                    if project.allocation != nil {
                        mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Allocation: " + project.allocation.state}
                        if project.allocation.grants != nil {
                            for j in project.allocation.grants.len() {
                                let grant = project.allocation.grants[j]
                                mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: grant.limits.tokens + " tokens · " + grant.limits.maxAgents + " agents · " + grant.limits.maxRatePerDay + " tokens/day"}
                                for k in grant.administratorMxids.len() { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Project administrator: " + grant.administratorMxids[k]} }
                            }
                        }
                    }
                    if project.canRequest { agent := mod.widgets.RinxPrimaryButton{text: "Request agent" on_click: || select_agent_resource(project)} }
                    if !project.canRequest { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: if project.state == "released" {"This failed allocation is closed. Request a new project using current resources."} else {"Project setup or membership verification is still pending. Refresh after setup completes."}} }
                }
            }
        }
        if P.page == "resources" || P.page == "agent_resources" {
            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Hagency contributes finite budgets. Project approval requests a reservation; allocation is confirmed only by Hagency's result."}
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No resource catalog is available yet."} }
            for i in P.rows.len() {
                let fleet = P.rows[i]
                if P.page == "resources" || fleet.id == P.selected.fleetId {
                    mod.widgets.PalpoCard{
                        mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: fleet.name}
                        mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: fleet.state}
                        if fleet.capabilities != nil {
                            for j in fleet.capabilities.offers.len() {
                                let offer = fleet.capabilities.offers[j]
                                for k in offer.resources.len() {
                                    let resource = offer.resources[k]
                                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: resource.name + " · " + offer.role}
                                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: resource.framework + " · " + resource.model}
                                    if P.page == "resources" && !P.approver {
                                        if resource.contributions == nil || resource.contributions.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No current finite contribution is available for a new project."} }
                                        if resource.contributions != nil {
                                            for c in resource.contributions.len() {
                                                let contribution = resource.contributions[c]
                                                mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Available: " + contribution.remaining.tokens + " tokens · " + contribution.remaining.maxAgents + " agents · " + contribution.remaining.maxRatePerDay + " tokens/day"}
                                                choose := mod.widgets.RinxPrimaryButton{text: "Request project using this resource" on_click: || request_project(fleet, resource, contribution)}
                                            }
                                        }
                                    }
                                    if P.page == "agent_resources" { choose := mod.widgets.RinxPrimaryButton{text: "Use this resource" on_click: || request_agent(resource, offer.role)} }
                                }
                            }
                        }
                    }
                }
            }
        }
        if P.page == "requests" {
            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Agent provisioning and connection readiness are verified by the server."}
            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Your assigned project administrator reviews agent allocations in Inbox. Hagency applies the decision within the project budget."}
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No agent requests yet. Open a project to request an agent."} }
            for i in P.rows.len() {
                let row = P.rows[i]
                mod.widgets.PalpoCard{
                    if row.agentDefinition != nil { mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: row.agentDefinition.name} }
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: row.role + " · " + row.state}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Initial request: " + row.requestedTokens + " tokens"}
                    if row.allocation != nil {
                        mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Confirmed allocation: " + row.allocation.tokens + " tokens · awaiting result: " + row.allocation.pendingTokens}
                    }
                    if row.lifecycle != nil {
                        if row.lifecycle.status != nil {
                            let status = row.lifecycle.status
                            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: if status.spentTokensLowerBound == nil {"Token usage: unknown"} else {"Observed usage: at least " + status.spentTokensLowerBound + " tokens"}}
                            if status.quotaPaused { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Paused: token allocation used up"} }
                            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: if row.lifecycle.stale {"Last observation is stale. Refresh to check for an update."} else {"Observed " + row.lifecycle.observedAt}}
                        }
                        if row.lifecycle.removalActionId != nil {
                            removal_status := mod.widgets.RinxButton{text: "View removal progress" on_click: || review_action({id: row.lifecycle.removalActionId})}
                        }
                    }
                    if row.actionId != nil { review := mod.widgets.RinxButton{text: "Open approval" on_click: || review_action({id: row.actionId})} }
                    if row.canOpenChat {
                        open_agent_chat := mod.widgets.RinxPrimaryButton{text: "Open agent chat" on_click: || {
                            call("palpo.requests.open", {requestId: row.id}, fn(data) { P.notice = "Opening the agent's project room in Rinx" })
                        }}
                    }
                    if row.canRequestTopUp { top_up := mod.widgets.RinxPrimaryButton{text: "Request more tokens" on_click: || request_top_up(row)} }
                    if row.canRemove { remove := mod.widgets.RinxButton{text: "Remove agent" on_click: || remove_agent(row.id)} }
                }
            }
        }
        if P.page == "fleets" {
            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Hagency owns and publishes resources. This page monitors existing connections."}
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No fleets are available to this account."} }
            for i in P.rows.len() {
                let fleet = P.rows[i]
                mod.widgets.PalpoCard{
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: fleet.name}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: connection_label(fleet) + " · " + fleet.ownerMxid}
                    if fleet.ownerMxid == P.user {
                        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                            export := mod.widgets.RinxButton{text: "Save configuration" on_click: || fleet_action(fleet, "export")}
                            if !connection_verified(fleet) { verify := mod.widgets.RinxButton{text: "Verify connection" on_click: || fleet_action(fleet, "connect")} }
                        }
                    }
                    if P.admin {
                        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                            identities := mod.widgets.RinxButton{text: "Matrix identities" on_click: || open_agents(fleet)}
                            install := mod.widgets.RinxButton{text: "Retry install" on_click: || fleet_action(fleet, "install")}
                            pause := mod.widgets.RinxButton{text: "Pause" on_click: || fleet_action(fleet, "pause")}
                            resume := mod.widgets.RinxButton{text: "Resume" on_click: || fleet_action(fleet, "resume")}
                            revoke := mod.widgets.RinxButton{text: "Revoke" on_click: || fleet_action(fleet, "revoke")}
                            queue := mod.widgets.RinxButton{text: "Delivery queue" on_click: || fleet_action(fleet, "queue")}
                            migrate := mod.widgets.RinxButton{text: "Use outbound" on_click: || fleet_action(fleet, "migrate")}
                        }
                    }
                }
            }
        }
        if P.page == "agents" {
            register := mod.widgets.RinxPrimaryButton{text: "Register approved identity" on_click: || register_identity()}
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No managed identities in this fleet."} }
            for i in P.rows.len() {
                let agent = P.rows[i]
                mod.widgets.PalpoCard{
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: agent.displayName}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: agent.mxid + " · " + agent.state}
                    rename := mod.widgets.RinxButton{text: "Rename" on_click: || rename_identity(agent)}
                    retire := mod.widgets.RinxButton{text: "Retire identity" on_click: || retire_identity(agent)}
                }
            }
        }
        if P.page == "activity" {
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No administration activity yet."} }
            for i in P.rows.len() { let row = P.rows[i] mod.widgets.PalpoCard{mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: row.action + " · " + row.result} mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: row.actor + " · " + row.at}} }
        }
        if P.page == "accounts" {
            mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "Account decisions open in their original trusted Matrix approval room."}
            if P.rows.len() == 0 { mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: "No account signup requests."} }
            for i in P.rows.len() {
                let row = P.rows[i]
                mod.widgets.PalpoCard{
                    mod.widgets.RinxLabel{width: Fill flow: Flow.Right{wrap: true} text: row.displayName + " · " + row.status}
                    mod.widgets.RinxHint{width: Fill flow: Flow.Right{wrap: true} text: row.reason}
                    if row.canOpen {
                        open_signup := mod.widgets.RinxPrimaryButton{text: "Open signup request" on_click: || call("palpo.accounts.open", {requestId: row.id}, fn(data){ P.notice = "Opening the original approval request in Rinx." })}
                    }
                }
            }
        }
    }
}}
